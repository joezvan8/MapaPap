# Supabase project URL (found in Supabase dashboard → Project Settings → API)
SUPABASE_URL=your-project-url-here

# Supabase secret/service role key (found in same dashboard page)
SUPABASE_SECRET_KEY=your-secret-key-here

# Note: injection is required to run the backend.
# dotenvx run -- python app.py is the command to use.